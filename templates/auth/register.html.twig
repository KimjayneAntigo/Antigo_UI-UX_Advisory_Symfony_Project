<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="turbo-prefetch" content="false">
  <meta name="turbo-visit-control" content="reload">
  <title>{{ pageTitle|default('Create Account | Antigo UI/UX Advisory') }}</title>

  <!-- Early Theme Initializer -->
  <script>
    (function() {
      try {
        var saved = localStorage.getItem('antigo-theme') || localStorage.getItem('antigo_theme');
        if (saved) document.documentElement.dataset.theme = saved;
      } catch(e) {}
    })();
  </script>

  <!-- Google Fonts: Poppins -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Iconify CDN -->
  <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: ['selector', '[data-theme="dark"]'],
      theme: {
        extend: {
          colors: {
            navy: '#13224B',
            violet: '#6C5BB5',
            blue: '#4C6CCB',
            'light-blue': '#DDEBFF',
            'light-gray': '#F4F6F8',
            'dark-gray': '#4b4b4b',
          },
          fontFamily: {
            poppins: ['Poppins', 'sans-serif'],
          },
        },
      },
    };
  </script>

  <!-- Global Design Tokens & App Styles -->
  <link rel="stylesheet" href="{{ asset('styles/app.css') }}">

  <style>
    .brand-gradient-panel {
      background: linear-gradient(135deg, #13224B 0%, #1c2c5e 40%, #6C5BB5 75%, #4C6CCB 100%);
    }
    .btn-brand-primary {
      background: linear-gradient(100deg, #13224B 0%, #6C5BB5 55%, #4C6CCB 100%);
      color: #FFFFFF;
      box-shadow: 0 14px 28px -10px rgba(76,108,203,.45);
      transition: transform .25s ease, box-shadow .25s ease;
    }
    .btn-brand-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 18px 34px -8px rgba(76,108,203,.6);
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between bg-[#F4F6F8] dark:bg-[#0B1230] text-[#13224B] dark:text-[#EEF1FF] font-poppins transition-colors duration-200">

  <!-- Minimal Header Bar -->
  <header class="w-full bg-white/80 dark:bg-[#121B42]/80 backdrop-blur-md border-b border-[rgba(19,34,75,0.08)] dark:border-white/10 py-4 px-6 sm:px-12 sticky top-0 z-40">
    <div class="max-w-[1360px] mx-auto flex items-center justify-between">
      <!-- Logo -->
      <a href="{{ path('admin_overview') }}" class="flex items-center gap-3 text-decoration-none group">
        <img src="{{ asset('images/antigo-mark.png') }}" alt="Antigo Logo" class="h-9 w-auto object-contain flex-shrink-0">
        <div class="flex flex-col justify-center leading-tight">
          <span class="font-extrabold text-lg tracking-wider text-[#13224B] dark:text-white">ANTIGO</span>
          <span class="text-[9px] tracking-widest text-[#6C5BB5] dark:text-[#DDEBFF] uppercase font-bold">UI/UX ADVISORY</span>
        </div>
      </a>

      <!-- Quick Back Links -->
      <div class="flex items-center gap-4 text-xs font-semibold">
        <a href="{{ path('app_login') }}" class="text-[#8890AA] hover:text-[#4C6CCB] transition-colors flex items-center gap-1.5">
          <iconify-icon icon="lucide:arrow-left"></iconify-icon>
          <span>Back to Log In</span>
        </a>
        <button type="button" onclick="toggleAntigoTheme()" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 border border-[rgba(19,34,75,0.1)] dark:border-white/15 flex items-center justify-center text-xs text-[#8890AA] dark:text-amber-300" title="Toggle theme">
          <iconify-icon icon="lucide:moon" class="dark-hidden"></iconify-icon>
          <iconify-icon icon="lucide:sun" class="light-hidden"></iconify-icon>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Auth Section -->
  <main class="flex-1 flex items-center justify-center p-4 sm:p-8 lg:p-12">
    <div class="w-full max-w-[1060px] min-h-[580px] bg-white dark:bg-[#121B42] rounded-3xl overflow-hidden border border-[rgba(19,34,75,0.08)] dark:border-white/10 shadow-2xl flex flex-col lg:flex-row">

      <!-- Left: Brand Gradient Panel -->
      <div class="lg:w-5/12 brand-gradient-panel p-8 sm:p-12 text-white flex flex-col justify-between relative overflow-hidden">
        <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-white/5 blur-2xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-72 h-72 rounded-full bg-[#6C5BB5]/30 blur-2xl pointer-events-none"></div>

        <div class="relative z-10">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-white text-xs font-semibold backdrop-blur-sm mb-8 border border-white/15">
            <iconify-icon icon="lucide:sparkles" class="text-sm text-[#DDEBFF]"></iconify-icon>
            <span>Client Portal Onboarding</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight leading-snug mb-4">
            Start your high-velocity design advisory.
          </h2>
          <p class="text-sm text-white/80 leading-relaxed">
            Create your account to track milestone sprint phases, review live prototypes, receive design token exports, and collaborate in real-time.
          </p>
        </div>

        <div class="relative z-10 pt-8 mt-8 border-t border-white/15">
          <div class="flex items-center gap-3">
            <img src="{{ asset('images/profile.png') }}" 
                 alt="Kimberly Jayne Antigo" 
                 class="w-11 h-11 rounded-full object-cover border-2 border-white/30 shadow-md flex-shrink-0"
                 onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden'); this.nextElementSibling.style.display='flex';">
            <div class="hidden w-11 h-11 rounded-full bg-[#4C6CCB] text-white font-bold text-sm items-center justify-center">KJ</div>
            <div>
              <div class="text-sm font-bold text-white">Kimberly Jayne Antigo</div>
              <div class="text-xs text-[#DDEBFF]/80">Founder &amp; Principal Consultant</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Register Form Column -->
      <div class="lg:w-7/12 p-8 sm:p-12 flex flex-col justify-between">
        <div>
          <!-- Header -->
          <div class="mb-7">
            <h1 class="text-2xl sm:text-3xl font-extrabold text-[#13224B] dark:text-white">Create Account</h1>
            <p class="text-xs sm:text-sm text-[#8890AA] mt-1">Join the Antigo client workspace to begin your sprint</p>
          </div>

          <!-- Register Form (Visual Only in Phase 1) -->
          <form class="space-y-4" onsubmit="event.preventDefault(); showPhase2Toast('Available once the database is connected.');">
            <!-- Full Name -->
            <div>
              <label for="name" class="block text-xs font-bold uppercase tracking-wider text-[#8890AA] mb-1.5">Full Name</label>
              <div class="relative">
                <input type="text" 
                       id="name" 
                       name="name" 
                       required 
                       placeholder="e.g. Maria Santos"
                       value="Maria Santos"
                       class="w-full px-4 py-3 rounded-xl border border-[rgba(19,34,75,0.12)] dark:border-white/15 bg-[#F4F6F8] dark:bg-[#0E1638] text-[#13224B] dark:text-white text-sm font-medium outline-none focus:border-[#6C5BB5] focus:bg-white dark:focus:bg-[#0E1638] transition-all">
                <iconify-icon icon="lucide:user" class="absolute right-4 top-3.5 text-[#8890AA] text-base pointer-events-none"></iconify-icon>
              </div>
            </div>

            <!-- Email Address -->
            <div>
              <label for="email" class="block text-xs font-bold uppercase tracking-wider text-[#8890AA] mb-1.5">Work Email</label>
              <div class="relative">
                <input type="email" 
                       id="email" 
                       name="email" 
                       required 
                       placeholder="maria@company.ph"
                       value="maria@pesolink.ph"
                       class="w-full px-4 py-3 rounded-xl border border-[rgba(19,34,75,0.12)] dark:border-white/15 bg-[#F4F6F8] dark:bg-[#0E1638] text-[#13224B] dark:text-white text-sm font-medium outline-none focus:border-[#6C5BB5] focus:bg-white dark:focus:bg-[#0E1638] transition-all">
                <iconify-icon icon="lucide:mail" class="absolute right-4 top-3.5 text-[#8890AA] text-base pointer-events-none"></iconify-icon>
              </div>
            </div>

            <!-- Password Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="password" class="block text-xs font-bold uppercase tracking-wider text-[#8890AA] mb-1.5">Password</label>
                <div class="relative">
                  <input type="password" 
                         id="password" 
                         name="password" 
                         required 
                         placeholder="••••••••"
                         value="••••••••••••"
                         class="w-full px-4 py-3 rounded-xl border border-[rgba(19,34,75,0.12)] dark:border-white/15 bg-[#F4F6F8] dark:bg-[#0E1638] text-[#13224B] dark:text-white text-sm font-medium outline-none focus:border-[#6C5BB5] focus:bg-white dark:focus:bg-[#0E1638] transition-all">
                  <iconify-icon icon="lucide:lock" class="absolute right-3.5 top-3.5 text-[#8890AA] text-base pointer-events-none"></iconify-icon>
                </div>
              </div>
              <div>
                <label for="confirm_password" class="block text-xs font-bold uppercase tracking-wider text-[#8890AA] mb-1.5">Confirm Password</label>
                <div class="relative">
                  <input type="password" 
                         id="confirm_password" 
                         name="confirm_password" 
                         required 
                         placeholder="••••••••"
                         value="••••••••••••"
                         class="w-full px-4 py-3 rounded-xl border border-[rgba(19,34,75,0.12)] dark:border-white/15 bg-[#F4F6F8] dark:bg-[#0E1638] text-[#13224B] dark:text-white text-sm font-medium outline-none focus:border-[#6C5BB5] focus:bg-white dark:focus:bg-[#0E1638] transition-all">
                  <iconify-icon icon="lucide:check-circle" class="absolute right-3.5 top-3.5 text-[#8890AA] text-base pointer-events-none"></iconify-icon>
                </div>
              </div>
            </div>

            <!-- Disclaimer -->
            <p class="text-[11px] text-[#8890AA] leading-relaxed pt-1">
              By creating an account, you agree to Antigo's Terms of Engagement and confidential advisory protocol.
            </p>

            <!-- Submit Button (Marked with data-phase2) -->
            <button type="submit" 
                    id="registerSubmitBtn"
                    data-phase2="register_submit"
                    data-phase2-label="Account Registration"
                    class="btn-brand-primary w-full py-3.5 rounded-xl font-bold uppercase text-xs tracking-wider flex items-center justify-center gap-2 cursor-pointer mt-2">
              <span>Create Client Account</span>
              <iconify-icon icon="lucide:arrow-right" class="text-base"></iconify-icon>
            </button>
          </form>

          <!-- Login Switch Link -->
          <div class="mt-6 pt-5 border-t border-[rgba(19,34,75,0.07)] dark:border-white/10 text-center">
            <p class="text-xs text-[#8890AA]">
              Already have an account?
              <a href="{{ path('app_login') }}" class="text-[#6C5BB5] dark:text-[#DDEBFF] font-semibold hover:underline ml-1">Sign In &rarr;</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="w-full py-6 text-center text-xs text-[#8890AA] border-t border-[rgba(19,34,75,0.06)] dark:border-white/10 bg-white dark:bg-[#0E1638]">
    &copy; 2026 Antigo UI/UX Advisory. All rights reserved.
  </footer>

  <script>
    function toggleAntigoTheme() {
      const root = document.documentElement;
      const current = root.dataset.theme || 'light';
      const next = current === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('antigo-theme', next);
        localStorage.setItem('antigo_theme', next);
      } catch (e) {}
    }
  </script>

  <!-- Phase 2 Toast Handler -->
  {% include '_partials/phase2-handler.html.twig' %}
</body>
</html>
