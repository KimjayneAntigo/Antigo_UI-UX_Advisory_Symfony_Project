{% extends 'client/base.html.twig' %}

{% block title %}Files &amp; Deliverables — Client Portal | Antigo{% endblock %}

{% block content %}
<div class="space-y-6">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-extrabold text-[#13224B] tracking-tight">Deliverables &amp; Files</h1>
      <p class="text-xs sm:text-sm text-[#8890AA] mt-0.5">Access design deliverables, prototypes, brand tokens, and audit reports.</p>
    </div>
  </div>

  <!-- Upload Area & Files Card (Matching Screenshot 1) -->
  <div class="bg-white rounded-3xl p-6 sm:p-7 border border-[rgba(19,34,75,0.08)] shadow-sm space-y-6">
    <div class="flex items-center justify-between">
      <h2 class="text-base font-extrabold text-[#13224B]">Files</h2>
      <span class="text-xs font-semibold text-[#8890AA]">{{ files|length }} files</span>
    </div>

    <!-- Drag & Drop Upload Zone (Matching Screenshot 1) -->
    <div class="border-2 border-dashed border-gray-200 dark:border-white/15 rounded-2xl p-8 text-center hover:border-[#6C5BB5] transition-colors cursor-pointer"
         onclick="alert('File upload dialog placeholder — upload handler will connect in Phase 2')">
      <div class="flex flex-col items-center justify-center space-y-2">
        <div class="w-10 h-10 rounded-full bg-violet-50 text-[#6C5BB5] flex items-center justify-center text-lg">
          <iconify-icon icon="lucide:upload-cloud"></iconify-icon>
        </div>
        <p class="text-xs font-bold text-[#6C5BB5]">
          Click to upload <span class="text-[#8890AA] font-normal">or drag a file here</span>
        </p>
        <p class="text-[10px] text-[#8890AA]">Figma archives, PDFs, ZIP assets up to 250MB</p>
      </div>
    </div>

    <!-- Files List (Matching Screenshot 1) -->
    <div class="space-y-3">
      {% for f in files %}
        <div class="p-4 rounded-2xl bg-[#F4F6F8] dark:bg-white/5 border border-[rgba(19,34,75,0.04)] flex items-center justify-between gap-4 hover:border-[#6C5BB5]/30 transition-all">
          <div class="flex items-center gap-3.5 min-w-0">
            <div class="w-9 h-9 rounded-xl bg-white dark:bg-white/10 text-[#6C5BB5] flex items-center justify-center text-lg flex-shrink-0 shadow-xs">
              {% if f.type == 'figma' %}
                <iconify-icon icon="lucide:figma"></iconify-icon>
              {% elseif f.type == 'pdf' %}
                <iconify-icon icon="lucide:file-text" class="text-rose-500"></iconify-icon>
              {% elseif f.type == 'zip' %}
                <iconify-icon icon="lucide:archive" class="text-amber-500"></iconify-icon>
              {% else %}
                <iconify-icon icon="lucide:file-code" class="text-blue-500"></iconify-icon>
              {% endif %}
            </div>
            <div class="min-w-0">
              <span class="text-xs font-bold text-[#13224B] truncate block">{{ f.name }}</span>
              <p class="text-[11px] text-[#8890AA] truncate mt-0.5">
                {{ f.uploaded_by }} uploaded &bull; {{ f.time }} &bull; {{ f.size }}
              </p>
            </div>
          </div>

          <div class="flex items-center gap-2 flex-shrink-0">
            <button type="button" 
                    onclick="alert('Downloading {{ f.name }}')" 
                    class="px-3.5 py-1.5 rounded-xl border border-[rgba(19,34,75,0.1)] hover:bg-white dark:hover:bg-white/10 text-xs font-bold text-[#13224B] transition-colors inline-flex items-center gap-1.5">
              <iconify-icon icon="lucide:download"></iconify-icon>
              <span class="hidden sm:inline">Download</span>
            </button>
          </div>
        </div>
      {% endfor %}
    </div>

  </div>

</div>
{% endblock %}
