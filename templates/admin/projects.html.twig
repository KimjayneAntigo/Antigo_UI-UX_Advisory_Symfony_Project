{% extends 'admin/base.html.twig' %}

{% block title %}Projects Portfolio — Studio Admin | Antigo{% endblock %}

{% block content %}
<div class="space-y-6">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-extrabold text-[#13224B] tracking-tight">Projects Portfolio &amp; Sprints</h1>
      <p class="text-xs sm:text-sm text-[#8890AA] mt-0.5">Oversee active design sprints, track deliverable milestones, and manage project lifecycles.</p>
    </div>
    
    <div class="flex items-center gap-2">
      <button type="button" 
              onclick="alert('Create New Project dialog placeholder')" 
              class="px-4 py-2 rounded-xl bg-[#13224B] hover:bg-[#1c3267] text-white text-xs font-bold shadow-sm transition-all inline-flex items-center gap-2">
        <iconify-icon icon="lucide:folder-plus"></iconify-icon>
        <span>New Project</span>
      </button>
    </div>
  </div>

  <!-- Filter Tabs -->
  <div class="flex items-center gap-2 flex-wrap">
    <button class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-[#13224B] text-white shadow-sm transition-all">
      All ({{ stats.all|default(4) }})
    </button>
    <button class="px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white text-[#4b4b4b] border border-[rgba(19,34,75,0.08)] hover:bg-[#F4F6F8] transition-all">
      Active ({{ stats.active|default(2) }})
    </button>
    <button class="px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white text-[#4b4b4b] border border-[rgba(19,34,75,0.08)] hover:bg-[#F4F6F8] transition-all">
      Review ({{ stats.review|default(1) }})
    </button>
    <button class="px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white text-[#4b4b4b] border border-[rgba(19,34,75,0.08)] hover:bg-[#F4F6F8] transition-all">
      Completed ({{ stats.completed|default(1) }})
    </button>
  </div>

  <!-- Featured Spotlight Card (Matching Screenshot 1) -->
  <div class="bg-white rounded-3xl p-6 sm:p-7 border border-[rgba(19,34,75,0.08)] shadow-sm space-y-6">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-gray-100 dark:border-white/10">
      <div>
        <div class="flex items-center gap-2">
          <span class="font-mono text-xs font-bold text-[#6C5BB5]">PRJ-3001</span>
          <span class="text-xs text-[#8890AA]">&bull;</span>
          <span class="text-xs text-[#8890AA]">Featured Active Sprint</span>
        </div>
        <h2 class="text-xl font-extrabold text-[#13224B] mt-0.5">Pesolink Banking Redesign</h2>
        <p class="text-xs text-[#8890AA] mt-0.5">Client: Maria Santos &bull; Fintech &bull; Mobile App</p>
      </div>

      <div class="flex items-center gap-3">
        <button type="button" 
                onclick="alert('Invoice dialog for Pesolink')" 
                class="px-4 py-2 rounded-xl border border-[rgba(19,34,75,0.15)] text-[#13224B] hover:bg-[#F4F6F8] text-xs font-bold transition-all">
          Send Invoice
        </button>
        <button type="button" 
                onclick="alert('Marking project complete')" 
                class="px-4 py-2 rounded-xl bg-[#13224B] hover:bg-[#1c3267] text-white text-xs font-bold shadow-md transition-all">
          Mark Complete
        </button>
      </div>
    </div>

    <!-- Stage and Progress bar -->
    <div class="p-4 rounded-2xl bg-[#F4F6F8] dark:bg-white/5 border border-[rgba(19,34,75,0.05)] flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="text-xs font-bold text-[#8890AA] uppercase tracking-wider">Stage</span>
        <span class="px-3 py-1 rounded-xl bg-white dark:bg-[#121B42] border border-[rgba(19,34,75,0.1)] text-xs font-bold text-[#13224B] shadow-sm">
          Design
        </span>
      </div>

      <div class="flex-1 max-w-lg mx-auto w-full space-y-1">
        <div class="w-full h-2.5 rounded-full bg-gray-200 dark:bg-white/10 overflow-hidden">
          <div class="h-full rounded-full bg-gradient-to-r from-[#4C6CCB] to-[#6C5BB5]" style="width: 65%;"></div>
        </div>
      </div>

      <div class="flex items-center gap-4 text-xs">
        <span class="font-extrabold text-[#13224B]">65%</span>
        <span class="text-[#8890AA]">Expected delivery: Sep 5, 2026</span>
      </div>
    </div>
  </div>

  <!-- Projects Grid / Table Card -->
  <div class="bg-white rounded-3xl border border-[rgba(19,34,75,0.08)] shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-[#F4F6F8] dark:bg-white/5 border-b border-[rgba(19,34,75,0.08)] text-[#8890AA] uppercase tracking-wider font-bold">
          <tr>
            <th class="py-4 px-6">Project Code &amp; Title</th>
            <th class="py-4 px-6">Client &amp; Service</th>
            <th class="py-4 px-6">Stage &amp; Progress</th>
            <th class="py-4 px-6">Budget ($ USD)</th>
            <th class="py-4 px-6">Target Delivery</th>
            <th class="py-4 px-6 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[rgba(19,34,75,0.05)]">
          {% for p in projects %}
            <tr class="hover:bg-[#F4F6F8]/60 dark:hover:bg-white/5 transition-colors">
              <td class="py-4 px-6">
                <span class="font-mono text-xs font-bold text-[#6C5BB5] block">{{ p.code }}</span>
                <a href="{{ path('admin_project_detail', {id: p.id}) }}" class="font-bold text-[#13224B] hover:text-[#4C6CCB] text-sm hover:underline">
                  {{ p.title }}
                </a>
                <span class="text-[11px] text-[#8890AA] block mt-0.5">{{ p.files_count }} files &bull; {{ p.messages_count }} messages</span>
              </td>
              <td class="py-4 px-6">
                <span class="font-semibold text-[#13224B] block">{{ p.client }} ({{ p.company }})</span>
                <span class="text-[11px] text-[#8890AA]">{{ p.service }}</span>
              </td>
              <td class="py-4 px-6 min-w-[180px]">
                <div class="flex items-center justify-between text-[11px] font-semibold mb-1">
                  <span class="text-[#13224B]">{{ p.stage }}</span>
                  <span class="text-[#4C6CCB]">{{ p.progress }}%</span>
                </div>
                <div class="w-full h-2 rounded-full bg-gray-200 dark:bg-white/10 overflow-hidden">
                  <div class="h-full rounded-full bg-gradient-to-r from-[#4C6CCB] to-[#6C5BB5]" style="width: {{ p.progress }}%;"></div>
                </div>
              </td>
              <td class="py-4 px-6 font-mono text-sm font-extrabold text-[#13224B]">
                {{ p.budget }}
              </td>
              <td class="py-4 px-6 text-[#8890AA] font-medium">
                {{ p.delivery_date }}
              </td>
              <td class="py-4 px-6 text-right space-x-2">
                <a href="{{ path('admin_project_detail', {id: p.id}) }}" 
                   class="inline-block px-3 py-1.5 rounded-xl border border-[rgba(19,34,75,0.1)] hover:bg-[#F4F6F8] text-[#13224B] text-xs font-semibold transition-colors">
                  Details &rarr;
                </a>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

</div>
{% endblock %}
