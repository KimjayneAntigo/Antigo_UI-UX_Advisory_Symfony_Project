{% extends 'admin/base.html.twig' %}

{% block title %}Studio Search: "{{ query }}" — Admin | Antigo{% endblock %}

{% block content %}
<div class="space-y-6">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs text-[#8890AA] mb-1">
        <a href="{{ path('admin_overview') }}" class="hover:text-[#13224B] dark:hover:text-white transition-colors">Studio Admin</a>
        <span>&rsaquo;</span>
        <span class="text-[#13224B] dark:text-white font-semibold">Global Search</span>
      </div>
      <h1 class="text-2xl font-extrabold text-[#13224B] dark:text-white tracking-tight">
        {% if query %}
          Search Results for <span class="text-[#4C6CCB] dark:text-[#DDEBFF]">"{{ query }}"</span>
        {% else %}
          Studio Global Search
        {% endif %}
      </h1>
      <p class="text-xs sm:text-sm text-[#8890AA] mt-0.5">Found {{ totalMatches }} match{{ totalMatches == 1 ? '' : 'es' }} across projects, client accounts, and inquiries.</p>
    </div>
    
    <div class="flex items-center gap-2">
      <span class="px-3.5 py-1.5 rounded-xl bg-white dark:bg-[#121B42] border border-[rgba(19,34,75,0.08)] dark:border-white/10 text-xs font-bold text-[#13224B] dark:text-white shadow-sm">
        {{ totalMatches }} Total Result{{ totalMatches == 1 ? '' : 's' }}
      </span>
    </div>
  </div>

  <!-- Search Input Bar -->
  <form method="GET" action="{{ path('admin_global_search') }}" class="p-4 rounded-2xl bg-white dark:bg-[#121B42] border border-[rgba(19,34,75,0.08)] dark:border-white/10 shadow-sm flex items-center gap-3">
    <div class="relative flex-1 w-full">
      <iconify-icon icon="lucide:search" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[#8890AA] text-xs pointer-events-none"></iconify-icon>
      <input type="text"
             name="q"
             value="{{ query }}"
             placeholder="Search across all projects, inquiries, clients..."
             class="w-full pl-9 pr-3 py-2 rounded-xl bg-[#F4F6F8] dark:bg-white/5 border border-transparent focus:border-[#4C6CCB] text-xs text-[#13224B] dark:text-white placeholder-[#8890AA] outline-none transition-all">
    </div>

    <button type="submit"
            class="px-5 py-2 rounded-xl bg-[#13224B] hover:bg-[#1c3267] text-white text-xs font-bold shadow-sm transition-all inline-flex items-center gap-2 cursor-pointer whitespace-nowrap">
      <iconify-icon icon="lucide:search" class="text-xs"></iconify-icon>
      <span>Search</span>
    </button>
  </form>

  {% if totalMatches == 0 %}
    <!-- Empty State -->
    <div class="bg-white dark:bg-[#121B42] rounded-3xl p-12 text-center border border-[rgba(19,34,75,0.08)] dark:border-white/10 shadow-sm space-y-3">
      <div class="w-14 h-14 rounded-2xl bg-gray-100 dark:bg-white/5 text-[#8890AA] mx-auto flex items-center justify-center text-3xl">
        <iconify-icon icon="lucide:search-x"></iconify-icon>
      </div>
      <div>
        <h3 class="text-base font-extrabold text-[#13224B] dark:text-white">No studio records found</h3>
        <p class="text-xs text-[#8890AA] mt-1 max-w-sm mx-auto">
          We couldn't find any projects, clients, or inquiries matching <span class="font-bold text-[#13224B] dark:text-white">"{{ query }}"</span>.
        </p>
      </div>
      <div class="pt-2">
        <a href="{{ path('admin_overview') }}" class="px-4 py-2 rounded-xl bg-[#13224B] hover:bg-[#1c3267] text-white text-xs font-bold shadow-sm transition-all inline-block">
          Return to Dashboard
        </a>
      </div>
    </div>
  {% else %}

    <!-- 1. Projects Matches -->
    {% if projects|length > 0 %}
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-base font-bold text-[#13224B] dark:text-white flex items-center gap-2">
            <iconify-icon icon="lucide:folder-kanban" class="text-[#4C6CCB]"></iconify-icon>
            <span>Projects ({{ projects|length }})</span>
          </h2>
          <a href="{{ path('admin_projects', {'q': query}) }}" class="text-xs font-semibold text-[#4C6CCB] dark:text-[#DDEBFF] hover:underline">
            View in Projects &rarr;
          </a>
        </div>

        <div class="bg-white dark:bg-[#121B42] rounded-3xl border border-[rgba(19,34,75,0.08)] dark:border-white/10 shadow-sm overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-[#F4F6F8] dark:bg-white/5 border-b border-[rgba(19,34,75,0.08)] dark:border-white/10 text-[#8890AA] uppercase tracking-wider font-bold">
                <tr>
                  <th class="py-3 px-6">Project Code &amp; Title</th>
                  <th class="py-3 px-6">Client</th>
                  <th class="py-3 px-6">Stage</th>
                  <th class="py-3 px-6">Budget ($ USD)</th>
                  <th class="py-3 px-6 text-right">Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[rgba(19,34,75,0.05)] dark:divide-white/5">
                {% for p in projects %}
                  <tr class="hover:bg-[#F4F6F8]/60 dark:hover:bg-white/5 transition-colors">
                    <td class="py-3.5 px-6">
                      <span class="font-mono text-xs font-bold text-[#6C5BB5] dark:text-[#DDEBFF] block">{{ p.projectCode }}</span>
                      <a href="{{ path('admin_project_detail', {'id': p.id}) }}" class="font-bold text-[#13224B] dark:text-white hover:text-[#4C6CCB] text-xs">
                        {{ p.title }}
                      </a>
                    </td>
                    <td class="py-3.5 px-6 font-semibold text-[#13224B] dark:text-white">
                      {{ p.clientName }}{% if p.company %} ({{ p.company }}){% endif %}
                    </td>
                    <td class="py-3.5 px-6">
                      <span class="px-2.5 py-1 rounded-full text-[10.5px] font-bold bg-[#DDEBFF] text-[#13224B] dark:bg-white/10 dark:text-white">
                        {{ p.currentPhase.label() }}
                      </span>
                    </td>
                    <td class="py-3.5 px-6 font-mono font-bold text-[#13224B] dark:text-white">
                      {{ p.formattedBudget }}
                    </td>
                    <td class="py-3.5 px-6 text-right">
                      <a href="{{ path('admin_project_detail', {'id': p.id}) }}" class="px-3 py-1.5 rounded-xl border border-[rgba(19,34,75,0.1)] dark:border-white/10 text-xs font-semibold text-[#13224B] dark:text-white hover:bg-[#F4F6F8] dark:hover:bg-white/10 transition-colors">
                        Open Sprint &rarr;
                      </a>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    {% endif %}

    <!-- 2. Inquiries Matches -->
    {% if inquiries|length > 0 %}
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-base font-bold text-[#13224B] dark:text-white flex items-center gap-2">
            <iconify-icon icon="lucide:inbox" class="text-[#6C5BB5]"></iconify-icon>
            <span>Inquiry Leads ({{ inquiries|length }})</span>
          </h2>
          <a href="{{ path('admin_inquiries', {'q': query}) }}" class="text-xs font-semibold text-[#4C6CCB] dark:text-[#DDEBFF] hover:underline">
            View in Inquiries &rarr;
          </a>
        </div>

        <div class="bg-white dark:bg-[#121B42] rounded-3xl border border-[rgba(19,34,75,0.08)] dark:border-white/10 shadow-sm overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-[#F4F6F8] dark:bg-white/5 border-b border-[rgba(19,34,75,0.08)] dark:border-white/10 text-[#8890AA] uppercase tracking-wider font-bold">
                <tr>
                  <th class="py-3 px-6">Reference &amp; Lead</th>
                  <th class="py-3 px-6">Company &amp; Email</th>
                  <th class="py-3 px-6">Service</th>
                  <th class="py-3 px-6">Budget</th>
                  <th class="py-3 px-6">Status</th>
                  <th class="py-3 px-6 text-right">Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[rgba(19,34,75,0.05)] dark:divide-white/5">
                {% for inq in inquiries %}
                  <tr class="hover:bg-[#F4F6F8]/60 dark:hover:bg-white/5 transition-colors">
                    <td class="py-3.5 px-6">
                      <span class="font-mono text-[11px] font-bold text-[#8890AA] block">{{ inq.reference }}</span>
                      <a href="{{ path('admin_inquiry_show', {'id': inq.id}) }}" class="font-bold text-[#13224B] dark:text-white hover:text-[#4C6CCB] text-xs">
                        {{ inq.name }}
                      </a>
                    </td>
                    <td class="py-3.5 px-6">
                      <span class="font-semibold text-[#13224B] dark:text-white block">{{ inq.company|default('—') }}</span>
                      <span class="text-[11px] text-[#4C6CCB] font-mono">{{ inq.email }}</span>
                    </td>
                    <td class="py-3.5 px-6 text-[#13224B] dark:text-white">
                      {{ inq.service }}
                    </td>
                    <td class="py-3.5 px-6 font-mono font-bold text-[#13224B] dark:text-white">
                      {{ inq.budget }}
                    </td>
                    <td class="py-3.5 px-6">
                      <span class="px-2.5 py-1 rounded-full text-[10.5px] font-bold bg-[#FFF1D6] text-[#946200]">
                        {{ inq.status.value|capitalize }}
                      </span>
                    </td>
                    <td class="py-3.5 px-6 text-right">
                      <a href="{{ path('admin_inquiry_show', {'id': inq.id}) }}" class="px-3 py-1.5 rounded-xl border border-[rgba(19,34,75,0.1)] dark:border-white/10 text-xs font-semibold text-[#13224B] dark:text-white hover:bg-[#F4F6F8] dark:hover:bg-white/10 transition-colors">
                        Review &rarr;
                      </a>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    {% endif %}

    <!-- 3. Clients Matches -->
    {% if clients|length > 0 %}
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-base font-bold text-[#13224B] dark:text-white flex items-center gap-2">
            <iconify-icon icon="lucide:users" class="text-emerald-600"></iconify-icon>
            <span>Clients Directory ({{ clients|length }})</span>
          </h2>
          <a href="{{ path('admin_clients', {'q': query}) }}" class="text-xs font-semibold text-[#4C6CCB] dark:text-[#DDEBFF] hover:underline">
            View in Clients &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {% for c in clients %}
            <div class="p-4 rounded-2xl bg-white dark:bg-[#121B42] border border-[rgba(19,34,75,0.08)] dark:border-white/10 shadow-sm flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-[#13224B] text-white font-bold text-xs flex items-center justify-center flex-shrink-0">
                {{ c.fullName|split(' ')|map(w => w|first)|join('')|upper }}
              </div>
              <div class="flex-1 min-w-0">
                <h4 class="font-bold text-[#13224B] dark:text-white text-xs truncate">{{ c.fullName }}</h4>
                <p class="text-[11px] text-[#8890AA] truncate">{{ c.company|default('Independent Client') }}</p>
                <a href="mailto:{{ c.email }}" class="text-[10.5px] text-[#4C6CCB] font-mono hover:underline truncate block mt-0.5">{{ c.email }}</a>
              </div>
              <a href="{{ path('admin_projects', {'q': c.fullName}) }}" class="px-2.5 py-1 rounded-lg border border-[rgba(19,34,75,0.1)] dark:border-white/10 text-[11px] font-semibold text-[#13224B] dark:text-white hover:bg-[#F4F6F8] dark:hover:bg-white/10 transition-colors flex-shrink-0">
                View
              </a>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

  {% endif %}

</div>
{% endblock %}
