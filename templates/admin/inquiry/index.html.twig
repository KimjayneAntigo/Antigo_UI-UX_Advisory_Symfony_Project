{% extends 'admin/base.html.twig' %}

{% block title %}Inquiry Leads Pipeline — Studio Admin | Antigo{% endblock %}

{% block content %}
<div class="space-y-6">

  <!-- Header & Stats Summary -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-extrabold text-[#13224B] dark:text-white tracking-tight">Inquiry Leads Pipeline</h1>
      <p class="text-xs sm:text-sm text-[#8890AA] mt-0.5">Qualify incoming leads, track client status, and convert inquiries to active projects.</p>
    </div>
    
    <div class="flex items-center gap-3">
      <span class="px-3 py-1.5 rounded-xl bg-white dark:bg-[#121B42] border border-[rgba(19,34,75,0.08)] dark:border-white/10 text-xs font-bold text-[#13224B] dark:text-white shadow-sm">
        Pending Review: <span class="text-[#6C5BB5] font-extrabold">{{ stats.new|default(0) }}</span>
      </span>
      <a href="{{ path('admin_inquiry_new') }}" 
         class="px-4 py-2 rounded-xl bg-[#13224B] hover:bg-[#1c3267] text-white text-xs font-bold shadow-sm hover:shadow-md transition-all inline-flex items-center gap-2 cursor-pointer">
        <iconify-icon icon="lucide:plus" class="text-sm"></iconify-icon>
        <span>New Inquiry</span>
      </a>
    </div>
  </div>

  <!-- Filter Tabs -->
  <div class="flex items-center gap-2 flex-wrap" id="inquiryFilterTabs">
    <button type="button" 
            onclick="filterInquiries('all')" 
            data-filter="all"
            class="filter-tab-btn px-3.5 py-1.5 rounded-xl text-xs font-bold bg-[#13224B] text-white shadow-sm transition-all">
      All ({{ stats.total|default(0) }})
    </button>
    <button type="button" 
            onclick="filterInquiries('new')" 
            data-filter="new"
            class="filter-tab-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-[#121B42] text-[#4b4b4b] dark:text-gray-300 border border-[rgba(19,34,75,0.08)] dark:border-white/10 hover:bg-[#F4F6F8] transition-all">
      New ({{ stats.new|default(0) }})
    </button>
    <button type="button" 
            onclick="filterInquiries('reviewed')" 
            data-filter="reviewed"
            class="filter-tab-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-[#121B42] text-[#4b4b4b] dark:text-gray-300 border border-[rgba(19,34,75,0.08)] dark:border-white/10 hover:bg-[#F4F6F8] transition-all">
      Reviewed ({{ stats.reviewed|default(0) }})
    </button>
    <button type="button" 
            onclick="filterInquiries('contacted')" 
            data-filter="contacted"
            class="filter-tab-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-[#121B42] text-[#4b4b4b] dark:text-gray-300 border border-[rgba(19,34,75,0.08)] dark:border-white/10 hover:bg-[#F4F6F8] transition-all">
      Contacted ({{ stats.contacted|default(0) }})
    </button>
    <button type="button" 
            onclick="filterInquiries('converted')" 
            data-filter="converted"
            class="filter-tab-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-[#121B42] text-[#4b4b4b] dark:text-gray-300 border border-[rgba(19,34,75,0.08)] dark:border-white/10 hover:bg-[#F4F6F8] transition-all">
      Converted ({{ stats.converted|default(0) }})
    </button>
  </div>

  <!-- Leads Table Card -->
  <div class="bg-white dark:bg-[#121B42] rounded-3xl border border-[rgba(19,34,75,0.08)] dark:border-white/10 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-[#F4F6F8] dark:bg-white/5 border-b border-[rgba(19,34,75,0.08)] dark:border-white/10 text-[#8890AA] uppercase tracking-wider font-bold">
          <tr>
            <th class="py-4 px-6">Lead / Reference</th>
            <th class="py-4 px-6">Company &amp; Contact</th>
            <th class="py-4 px-6">Requested Service</th>
            <th class="py-4 px-6">Budget ($ USD)</th>
            <th class="py-4 px-6">Status</th>
            <th class="py-4 px-6 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[rgba(19,34,75,0.05)] dark:divide-white/5">
          {% for lead in inquiries %}
            <tr class="inquiry-row hover:bg-[#F4F6F8]/60 dark:hover:bg-white/5 transition-colors" data-status="{{ lead.status.value }}">
              <td class="py-4 px-6">
                <span class="font-mono text-[10.5px] font-bold text-[#8890AA] block">{{ lead.reference }}</span>
                <a href="{{ path('admin_inquiry_show', {'id': lead.id}) }}" class="font-bold text-[#13224B] dark:text-white hover:text-[#4C6CCB] text-sm transition-colors">
                  {{ lead.name }}
                </a>
                <span class="text-[11px] text-[#8890AA] block mt-0.5">{{ lead.createdAt|date('M d, Y') }}</span>
              </td>
              <td class="py-4 px-6">
                <span class="font-semibold text-[#13224B] dark:text-white block">{{ lead.company|default('—') }}</span>
                <a href="mailto:{{ lead.email }}" class="text-[11px] text-[#4C6CCB] dark:text-[#DDEBFF] font-mono hover:underline">
                  {{ lead.email }}
                </a>
              </td>
              <td class="py-4 px-6 font-medium text-[#13224B] dark:text-white max-w-xs">
                <span>{{ lead.service }}</span>
                <p class="text-[11px] text-[#8890AA] line-clamp-1 mt-0.5">{{ lead.description }}</p>
              </td>
              <td class="py-4 px-6 font-mono font-bold text-[#13224B] dark:text-white">
                {{ lead.budget }}
              </td>
              <td class="py-4 px-6">
                {% if lead.status.value == 'new' %}
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10.5px] font-bold bg-[#FFF1D6] text-[#946200] whitespace-nowrap">New Lead</span>
                {% elseif lead.status.value == 'reviewed' %}
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10.5px] font-bold bg-[rgba(108,91,181,0.14)] text-[#6C5BB5] whitespace-nowrap">Reviewed</span>
                {% elseif lead.status.value == 'contacted' %}
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10.5px] font-bold bg-[#DDEBFF] text-[#13224B] whitespace-nowrap">Contacted</span>
                {% elseif lead.status.value == 'converted' %}
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10.5px] font-bold bg-[#DFF6E8] text-[#127A45] whitespace-nowrap">Converted</span>
                {% else %}
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10.5px] font-bold bg-gray-100 text-gray-600 whitespace-nowrap">{{ lead.status.value|capitalize }}</span>
                {% endif %}
              </td>
              <td class="py-4 px-6 text-right">
                <div class="inline-flex items-center gap-1.5">
                  <a href="{{ path('admin_inquiry_show', {'id': lead.id}) }}" 
                     class="px-3 py-1.5 rounded-xl border border-[rgba(19,34,75,0.1)] dark:border-white/10 hover:bg-[#F4F6F8] dark:hover:bg-white/10 text-xs font-semibold text-[#13224B] dark:text-white transition-colors"
                     title="View Details">
                    View
                  </a>
                  <a href="{{ path('admin_inquiry_edit', {'id': lead.id}) }}" 
                     class="px-3 py-1.5 rounded-xl border border-[rgba(19,34,75,0.1)] dark:border-white/10 hover:bg-[#F4F6F8] dark:hover:bg-white/10 text-xs font-semibold text-[#13224B] dark:text-white transition-colors"
                     title="Edit Lead">
                    Edit
                  </a>
                  {{ include('admin/inquiry/_delete_form.html.twig', {'inquiry': lead}) }}
                </div>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="6" class="py-12 text-center text-[#8890AA]">
                <div class="w-12 h-12 rounded-2xl bg-gray-100 dark:bg-white/5 text-[#8890AA] mx-auto flex items-center justify-center text-2xl mb-2">
                  <iconify-icon icon="lucide:inbox"></iconify-icon>
                </div>
                <p class="font-bold text-sm text-[#13224B] dark:text-white">No inquiries found in pipeline</p>
                <p class="text-xs mt-1">Create a new lead or await incoming consultations from the client portal.</p>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

</div>

<script>
  function filterInquiries(status) {
    const rows = document.querySelectorAll('.inquiry-row');
    rows.forEach(row => {
      if (status === 'all' || row.dataset.status === status) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });

    document.querySelectorAll('.filter-tab-btn').forEach(btn => {
      if (btn.dataset.filter === status) {
        btn.className = 'filter-tab-btn px-3.5 py-1.5 rounded-xl text-xs font-bold bg-[#13224B] text-white shadow-sm transition-all';
      } else {
        btn.className = 'filter-tab-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-[#121B42] text-[#4b4b4b] dark:text-gray-300 border border-[rgba(19,34,75,0.08)] dark:border-white/10 hover:bg-[#F4F6F8] transition-all';
      }
    });
  }
</script>
{% endblock %}
