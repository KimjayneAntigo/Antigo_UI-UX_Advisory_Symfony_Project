{% extends 'admin/base.html.twig' %}

{% block title %}Edit {{ inquiry.reference }} — Studio Admin | Antigo{% endblock %}

{% block content %}
<div class="space-y-6 max-w-4xl mx-auto">

  <!-- Breadcrumb & Header -->
  <div class="flex items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <a href="{{ path('admin_inquiries') }}" 
         class="w-9 h-9 rounded-full bg-white dark:bg-[#121B42] border border-[rgba(19,34,75,0.1)] dark:border-white/10 flex items-center justify-center text-[#13224B] dark:text-white hover:bg-[#F4F6F8] transition-colors"
         title="Back to Inquiries">
        <iconify-icon icon="lucide:arrow-left" class="text-base"></iconify-icon>
      </a>
      <div>
        <nav class="flex items-center gap-1.5 text-[10.5px] font-bold uppercase tracking-wider text-[#8890AA]">
          <a href="{{ path('admin_inquiries') }}" class="hover:underline">Inquiries</a>
          <iconify-icon icon="lucide:chevron-right" class="text-[10px]"></iconify-icon>
          <a href="{{ path('admin_inquiry_show', {'id': inquiry.id}) }}" class="hover:underline">{{ inquiry.reference }}</a>
          <iconify-icon icon="lucide:chevron-right" class="text-[10px]"></iconify-icon>
          <span class="text-[#13224B] dark:text-white">Edit</span>
        </nav>
        <h1 class="text-xl sm:text-2xl font-extrabold text-[#13224B] dark:text-white tracking-tight mt-0.5">
          Edit Lead: {{ inquiry.name }} ({{ inquiry.reference }})
        </h1>
      </div>
    </div>

    <div>
      {{ include('admin/inquiry/_delete_form.html.twig', {'inquiry': inquiry}) }}
    </div>
  </div>

  <!-- Form Card -->
  <div class="bg-white dark:bg-[#121B42] rounded-3xl p-6 sm:p-8 border border-[rgba(19,34,75,0.08)] dark:border-white/10 shadow-sm space-y-6">
    <div>
      <h2 class="text-base font-extrabold text-[#13224B] dark:text-white">Update Lead Details</h2>
      <p class="text-xs text-[#8890AA] mt-0.5">Modify contact info, timeline, estimated budget, or update status in pipeline.</p>
    </div>

    {{ include('admin/inquiry/_form.html.twig', {'button_label': 'Update Inquiry'}) }}
  </div>

</div>
{% endblock %}
