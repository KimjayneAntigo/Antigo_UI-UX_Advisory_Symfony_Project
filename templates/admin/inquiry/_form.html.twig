{{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}

  {# Global form errors if any #}
  {% if not form.vars.valid and form.vars.errors|length > 0 %}
    <div class="p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900 text-rose-800 dark:text-rose-200 text-xs font-semibold space-y-1">
      {{ form_errors(form) }}
    </div>
  {% endif %}

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    
    {# 1. Name #}
    <div class="space-y-1.5">
      {{ form_label(form.name, null, {'label_attr': {'class': 'block text-xs font-bold text-[#13224B] dark:text-[#DDEBFF]'}}) }}
      {{ form_widget(form.name, {'attr': {'class': 'w-full px-4 py-2.5 rounded-xl border border-[rgba(19,34,75,0.12)] dark:border-white/15 bg-[#F4F6F8] dark:bg-[#0E1638] text-xs font-semibold text-[#13224B] dark:text-white outline-none focus:ring-2 focus:ring-[#4C6CCB] transition-all' ~ (form.name.vars.valid ? '' : ' border-rose-500 ring-1 ring-rose-500')}}) }}
      {% if not form.name.vars.valid %}
        <div class="text-[11px] font-bold text-rose-600 dark:text-rose-400 mt-1">
          {{ form_errors(form.name) }}
        </div>
      {% endif %}
    </div>

