    {{ form_widget(form.description, {'attr': {'class': 'w-full px-4 py-2.5 rounded-xl border border-[rgba(19,34,75,0.12)] dark:border-white/15 bg-[#F4F6F8] dark:bg-[#0E1638] text-xs font-semibold text-[#13224B] dark:text-white outline-none focus:ring-2 focus:ring-[#4C6CCB] transition-all' ~ (form.description.vars.valid ? '' : ' border-rose-500 ring-1 ring-rose-500')}}) }}
