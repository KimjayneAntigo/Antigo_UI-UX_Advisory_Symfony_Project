  {# Form Actions #}
  <div class="flex items-center justify-end gap-3 pt-4 border-t border-[rgba(19,34,75,0.08)] dark:border-white/10">
    <a href="{{ path('admin_inquiries') }}" class="px-4 py-2.5 rounded-xl border border-[rgba(19,34,75,0.12)] dark:border-white/15 text-xs font-bold text-[#8890AA] hover:text-[#13224B] dark:hover:text-white transition-colors">
      Cancel
    </a>
    <button type="submit" class="px-5 py-2.5 rounded-xl bg-[#13224B] hover:bg-[#1c3267] text-white text-xs font-bold shadow-md hover:shadow-lg transition-all inline-flex items-center gap-2 cursor-pointer">
      <iconify-icon icon="lucide:check" class="text-sm"></iconify-icon>
      <span>{{ button_label|default('Save Inquiry') }}</span>
