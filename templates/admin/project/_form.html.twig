    {# 1. Title #}
    <div class="md:col-span-2 space-y-1.5">
      {{ form_label(form.title, null, {'label_attr': {'class': 'block text-xs font-bold text-[#13224B] dark:text-[#DDEBFF]'}}) }}
      {{ form_widget(form.title, {'attr': {'class': 'w-full px-4 py-2.5 rounded-xl border border-[rgba(19,34,75,0.12)] dark:border-white/15 bg-[#F4F6F8] dark:bg-[#0E1638] text-xs font-semibold text-[#13224B] dark:text-white outline-none focus:ring-2 focus:ring-[#4C6CCB] transition-all' ~ (form.title.vars.valid ? '' : ' border-rose-500 ring-1 ring-rose-500')}}) }}
      {% if not form.title.vars.valid %}
        <div class="text-[11px] font-bold text-rose-600 dark:text-rose-400 mt-1">
          {{ form_errors(form.title) }}
        </div>
      {% endif %}
