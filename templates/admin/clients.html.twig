{% extends 'admin/base.html.twig' %}

{% block title %}Clients — Registered Directory | Antigo{% endblock %}

{% block content %}
<div class="space-y-6">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-extrabold text-[#13224B] dark:text-white tracking-tight">Registered Clients Directory</h1>
      <p class="text-xs sm:text-sm text-[#8890AA] mt-0.5">Directory of verified client accounts, associated design projects, and collaboration history.</p>
    </div>
    
    <div class="flex items-center gap-2">
      <span class="px-3.5 py-1.5 rounded-xl bg-white dark:bg-[#121B42] border border-[rgba(19,34,75,0.08)] dark:border-white/10 text-xs font-bold text-[#13224B] dark:text-white shadow-sm">
        Total Clients: {{ stats.total|default(0) }}
      </span>
    </div>
  </div>

  <!-- Filter Bar (Part C) -->
  <form method="GET" action="{{ path('admin_clients') }}" class="p-4 rounded-2xl bg-white dark:bg-[#121B42] border border-[rgba(19,34,75,0.08)] dark:border-white/10 shadow-sm flex flex-col sm:flex-row items-center gap-3">
    <div class="relative flex-1 w-full">
      <iconify-icon icon="lucide:search" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[#8890AA] text-xs pointer-events-none"></iconify-icon>
      <input type="text"
             name="q"
             value="{{ currentQuery|default('') }}"
             placeholder="Search clients by name, company, or email..."
             class="w-full pl-9 pr-3 py-2 rounded-xl bg-[#F4F6F8] dark:bg-white/5 border border-transparent focus:border-[#4C6CCB] text-xs text-[#13224B] dark:text-white placeholder-[#8890AA] outline-none transition-all">
    </div>

    <div class="flex items-center gap-2 w-full sm:w-auto">
      <button type="submit"
              class="px-4 py-2 rounded-xl bg-[#13224B] hover:bg-[#1c3267] text-white text-xs font-bold shadow-sm transition-all inline-flex items-center gap-1.5 cursor-pointer whitespace-nowrap">
        <iconify-icon icon="lucide:search" class="text-xs"></iconify-icon>
        <span>Search</span>
      </button>

      {% if currentQuery %}
        <a href="{{ path('admin_clients') }}"
           class="px-3 py-2 rounded-xl border border-[rgba(19,34,75,0.15)] dark:border-white/10 hover:bg-[#F4F6F8] dark:hover:bg-white/5 text-[#8890AA] hover:text-[#13224B] dark:hover:text-white text-xs font-semibold transition-all whitespace-nowrap">
          Clear
        </a>
      {% endif %}
    </div>
  </form>

  <!-- Clients Directory Table Card -->
  <div class="bg-white dark:bg-[#121B42] rounded-3xl border border-[rgba(19,34,75,0.08)] dark:border-white/10 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-[#F4F6F8] dark:bg-white/5 border-b border-[rgba(19,34,75,0.08)] dark:border-white/10 text-[#8890AA] uppercase tracking-wider font-bold">
          <tr>
            <th class="py-4 px-6">Client / Contact</th>
            <th class="py-4 px-6">Company &amp; Phone</th>
            <th class="py-4 px-6">Active Projects</th>
            <th class="py-4 px-6">Total Value ($ USD)</th>
            <th class="py-4 px-6">Member Since</th>
            <th class="py-4 px-6 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[rgba(19,34,75,0.05)] dark:divide-white/5">
          {% for c in clients %}
            {% set activeCount = 0 %}
            {% set totalValue = 0 %}
            {% for p in c.projects %}
              {% set totalValue = totalValue + p.budget %}
              {% if not p.isCompleted and not p.isCancelled %}
                {% set activeCount = activeCount + 1 %}
              {% endif %}
            {% endfor %}
            <tr class="hover:bg-[#F4F6F8]/60 dark:hover:bg-white/5 transition-colors">
              <td class="py-4 px-6">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-full bg-[#13224B] text-white font-bold text-xs flex items-center justify-center flex-shrink-0">
                    {{ c.fullName|split(' ')|map(w => w|first)|join('')|upper }}
                  </div>
                  <div>
                    <span class="font-bold text-[#13224B] dark:text-white text-sm block">{{ c.fullName }}</span>
                    <a href="mailto:{{ c.email }}" class="text-[11px] text-[#4C6CCB] dark:text-[#DDEBFF] font-mono hover:underline">{{ c.email }}</a>
                  </div>
                </div>
              </td>
              <td class="py-4 px-6">
                <span class="font-semibold text-[#13224B] dark:text-white block">{{ c.company|default('Independent') }}</span>
                <span class="text-[11px] text-[#8890AA]">{{ c.phone|default('No phone listed') }}</span>
              </td>
              <td class="py-4 px-6">
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10.5px] font-bold whitespace-nowrap {{ activeCount > 0 ? 'bg-[#DDEBFF] text-[#13224B] dark:bg-white/10 dark:text-white' : 'bg-gray-100 dark:bg-white/5 text-gray-600 dark:text-gray-400' }}">
                  {{ activeCount }} Active
                </span>
              </td>
              <td class="py-4 px-6 font-mono font-bold text-sm text-[#13224B] dark:text-white">
                ${{ (totalValue / 100)|number_format(0) }}
              </td>
              <td class="py-4 px-6 text-[#8890AA]">
                {{ c.createdAt|date('M d, Y') }}
              </td>
              <td class="py-4 px-6 text-right space-x-2">
                <a href="{{ path('admin_projects', {'q': c.fullName}) }}"
                   class="px-3 py-1.5 rounded-xl border border-[rgba(19,34,75,0.1)] dark:border-white/10 hover:bg-[#F4F6F8] dark:hover:bg-white/10 text-[#13224B] dark:text-white text-xs font-semibold transition-colors">
                  Projects &rarr;
                </a>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="6" class="py-12 text-center text-[#8890AA]">
                <div class="w-12 h-12 rounded-2xl bg-gray-100 dark:bg-white/5 text-[#8890AA] mx-auto flex items-center justify-center text-2xl mb-2">
                  <iconify-icon icon="lucide:users"></iconify-icon>
                </div>
                {% if currentQuery %}
                  <p class="font-bold text-sm text-[#13224B] dark:text-white">No clients found matching "{{ currentQuery }}"</p>
                  <p class="text-xs mt-1">Try searching with a different name, company, or email keyword.</p>
                  <a href="{{ path('admin_clients') }}" class="inline-block mt-3 px-3 py-1.5 rounded-xl bg-[#13224B] text-white text-xs font-semibold">
                    Clear Search
                  </a>
                {% else %}
                  <p class="font-bold text-sm text-[#13224B] dark:text-white">No registered client accounts</p>
                  <p class="text-xs mt-1">Client accounts will appear here once verified.</p>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

</div>
{% endblock %}
