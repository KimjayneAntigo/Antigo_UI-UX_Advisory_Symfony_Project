{% extends 'admin/base.html.twig' %}

{% block title %}Clients — Registered Directory | Antigo{% endblock %}

{% block content %}
<div class="space-y-6">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-extrabold text-[#13224B] tracking-tight">Registered Clients Directory</h1>
      <p class="text-xs sm:text-sm text-[#8890AA] mt-0.5">Directory of verified client accounts, associated design projects, and collaboration history.</p>
    </div>
    
    <div class="flex items-center gap-2">
      <span class="px-3.5 py-1.5 rounded-xl bg-white border border-[rgba(19,34,75,0.08)] text-xs font-bold text-[#13224B] shadow-sm">
        Total Clients: {{ stats.total|default(4) }}
      </span>
    </div>
  </div>

  <!-- Clients Directory Table Card -->
  <div class="bg-white rounded-3xl border border-[rgba(19,34,75,0.08)] shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-[#F4F6F8] dark:bg-white/5 border-b border-[rgba(19,34,75,0.08)] text-[#8890AA] uppercase tracking-wider font-bold">
          <tr>
            <th class="py-4 px-6">Client / Contact</th>
            <th class="py-4 px-6">Company &amp; Role</th>
            <th class="py-4 px-6">Active Projects</th>
            <th class="py-4 px-6">Total Spend ($ USD)</th>
            <th class="py-4 px-6">Member Since</th>
            <th class="py-4 px-6 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[rgba(19,34,75,0.05)]">
          {% for c in clients %}
            <tr class="hover:bg-[#F4F6F8]/60 dark:hover:bg-white/5 transition-colors">
              <td class="py-4 px-6">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-full bg-[#13224B] text-white font-bold text-xs flex items-center justify-center flex-shrink-0">
                    {{ c.avatar_initials }}
                  </div>
                  <div>
                    <span class="font-bold text-[#13224B] text-sm block">{{ c.name }}</span>
                    <span class="text-[11px] text-[#4C6CCB] font-mono">{{ c.email }}</span>
                  </div>
                </div>
              </td>
              <td class="py-4 px-6">
                <span class="font-semibold text-[#13224B] block">{{ c.company }}</span>
                <span class="text-[11px] text-[#8890AA]">{{ c.role }} &bull; {{ c.phone }}</span>
              </td>
              <td class="py-4 px-6">
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10.5px] font-bold whitespace-nowrap {{ c.active_projects > 0 ? 'bg-[#DDEBFF] text-[#13224B] badge-active' : 'bg-gray-100 text-gray-600' }}">
                  {{ c.active_projects }} Active
                </span>
              </td>
              <td class="py-4 px-6 font-mono font-bold text-sm text-[#13224B]">
                {{ c.total_spend }}
              </td>
              <td class="py-4 px-6 text-[#8890AA]">
                {{ c.joined }}
              </td>
              <td class="py-4 px-6 text-right space-x-2">
                <button type="button" 
                        onclick="alert('Viewing client profile: {{ c.name }}')" 
                        class="px-3 py-1.5 rounded-xl border border-[rgba(19,34,75,0.1)] hover:bg-[#F4F6F8] text-[#13224B] text-xs font-semibold transition-colors">
                  Profile
                </button>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

</div>
{% endblock %}
