{% extends 'admin/base.html.twig' %}

{% block title %}Project Not Found (404) &mdash; Studio Admin{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto py-12 px-4 text-center space-y-6">
  <div class="w-20 h-20 rounded-3xl bg-rose-500/10 text-rose-500 dark:text-rose-400 mx-auto flex items-center justify-center text-4xl shadow-sm">
    <iconify-icon icon="lucide:folder-x"></iconify-icon>
  </div>

  <div class="space-y-2">
    <span class="inline-block px-3 py-1 rounded-full text-xs font-mono font-bold bg-rose-100 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300">
      404 &bull; Resource Not Found
    </span>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-[#13224B] dark:text-white">
      Project Not Found
    </h1>
    <p class="text-xs sm:text-sm text-[#8890AA] dark:text-gray-400 max-w-md mx-auto">
      The project you requested {% if requestedId is defined %}(ID #{{ requestedId }}){% endif %} does not exist or may have been permanently removed from the studio workspace.
    </p>
  </div>

  <div class="pt-2 flex items-center justify-center gap-3">
    <a href="{{ path('admin_projects') }}" 
       class="inline-flex items-center gap-2 px-5 py-2.5 rounded-2xl bg-[#13224B] dark:bg-[#4C6CCB] text-white text-xs font-bold shadow hover:opacity-90 transition-all">
      <iconify-icon icon="lucide:arrow-left"></iconify-icon>
      <span>Back to Projects</span>
    </a>
    <a href="{{ path('admin_overview') }}" 
       class="inline-flex items-center gap-2 px-5 py-2.5 rounded-2xl border border-[rgba(19,34,75,0.12)] dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5 text-xs font-bold text-[#13224B] dark:text-white transition-all">
      <iconify-icon icon="lucide:home"></iconify-icon>
      <span>Dashboard Overview</span>
    </a>
  </div>
</div>
{% endblock %}
