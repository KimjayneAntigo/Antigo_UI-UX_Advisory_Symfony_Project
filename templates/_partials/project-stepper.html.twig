{# Project 5-Phase Milestone Stepper Component #}
{# Parameters: 
   - currentPhase: integer (1 to 5)
   - progressPercent: integer (optional, defaults to currentPhase info)
   - phaseName: string (optional)
   - showHeader: boolean (default true)
#}

{% set curPhaseNum = currentPhase|default(1)|number_format %}
{% set phaseInfo = project_phases[curPhaseNum]|default(project_phases[1]) %}
{% set pct = progressPercent|default(phaseInfo.progress) %}
{% set displayName = phaseName|default(phaseInfo.name) %}

<div class="stepper-component w-full">
  {% if showHeader|default(true) %}
    <!-- Stepper Progress Header -->
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center gap-2">
        <span class="text-xs font-semibold text-[#4b4b4b] dark:text-white/70">
          Phase {{ curPhaseNum }}:
          <strong class="text-[#13224B] dark:text-white">{{ displayName }}</strong>
        </span>
        {% if curPhaseNum == 5 %}
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#DFF6E8] text-[#127A45] border border-[#127A45]/20">
            Sprint Completed
          </span>
        {% endif %}
      </div>
      <span class="text-xs font-extrabold text-[#6C5BB5] dark:text-[#DDEBFF]">{{ pct }}%</span>
    </div>

    <!-- Progress Bar Track -->
    <div class="w-full h-2 rounded-full bg-[#13224B]/10 dark:bg-white/10 overflow-hidden mb-6">
      <div class="h-full rounded-full bg-gradient-to-r from-[#4C6CCB] to-[#6C5BB5] transition-all duration-500 ease-out"
           style="width: {{ pct }}%;"></div>
    </div>
  {% endif %}

  <!-- 5-Step Milestone Grid -->
  <div class="grid grid-cols-5 gap-2 sm:gap-3">
    {% for num, info in project_phases %}
      {% set stepNum = num|number_format %}
      {# 
        State determination:
        - If curPhaseNum == 5 and stepNum == 5, step 5 is 'done' (completed green check, fixes known bug!)
        - If stepNum < curPhaseNum, step is 'done'
        - If stepNum == curPhaseNum, step is 'active'
        - If stepNum > curPhaseNum, step is 'future'
      #}
      {% if curPhaseNum == 5 and stepNum == 5 %}
        {% set state = 'done' %}
      {% elseif stepNum < curPhaseNum %}
        {% set state = 'done' %}
      {% elseif stepNum == curPhaseNum %}
        {% set state = 'active' %}
      {% else %}
        {% set state = 'future' %}
      {% endif %}

      <div class="flex flex-col items-center text-center gap-2 group">
        <!-- Circle indicator -->
        <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full flex items-center justify-center text-xs font-extrabold flex-shrink-0 transition-transform duration-200
          {% if state == 'done' %}
            bg-[#10b981] text-white shadow-sm ring-2 ring-[#10b981]/20
          {% elseif state == 'active' %}
            bg-gradient-to-r from-[#4C6CCB] to-[#6C5BB5] text-white ring-4 ring-[#6C5BB5]/25 shadow-md scale-105
          {% else %}
            bg-white dark:bg-[#0E1638] border border-[rgba(19,34,75,0.15)] dark:border-white/15 text-[#8890AA]
          {% endif %}">
          {% if state == 'done' %}
            <iconify-icon icon="lucide:check" class="text-sm stroke-[3]"></iconify-icon>
          {% else %}
            <span>{{ stepNum }}</span>
          {% endif %}
        </div>

        <!-- Phase Label -->
        <div class="flex flex-col items-center">
          <span class="text-[10px] sm:text-[11px] font-semibold leading-tight line-clamp-2
            {% if state == 'done' %}
              text-[#10b981] dark:text-emerald-400 font-bold
            {% elseif state == 'active' %}
              text-[#6C5BB5] dark:text-[#DDEBFF] font-bold
            {% else %}
              text-[#8890AA]
            {% endif %}">
            {{ info.name }}
          </span>
          <span class="text-[9px] text-[#8890AA]/80 hidden sm:inline-block mt-0.5">
            {{ info.progress }}%
          </span>
        </div>
      </div>
    {% endfor %}
  </div>
</div>
