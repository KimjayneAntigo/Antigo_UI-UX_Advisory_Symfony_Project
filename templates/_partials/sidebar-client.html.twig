{# Client Sidebar Partial #}
{% set currentRoute = app.request.attributes.get('_route') %}


<!-- Mobile Sidebar Backdrop -->
<div id="client-sidebar-backdrop" 
     onclick="toggleClientSidebar()" 
     class="hidden fixed inset-0 z-40 bg-black/60 backdrop-blur-sm lg:hidden transition-opacity"></div>

<!-- Client Sidebar -->
<aside id="client-sidebar" data-turbo="false" data-turbo-prefetch="false" 
       class="fixed inset-y-0 left-0 z-40 w-64 bg-[#13224B] text-white flex flex-col justify-between py-6 px-4 transition-transform duration-300 ease-in-out -translate-x-full lg:translate-x-0 lg:sticky lg:top-0 lg:h-screen lg:max-h-screen lg:self-start lg:flex-shrink-0 select-none border-r border-white/10 shadow-2xl lg:shadow-none overflow-y-auto sidebar-scroll">

  <!-- Top: Logo & Navigation -->
  <div class="space-y-6">
    <!-- Brand / Client Portal Logo -->
    <div class="flex items-center justify-between px-2">
      <a href="{{ path('client_dashboard') }}" class="flex items-center gap-3 group" title="Antigo UI/UX Advisory — Client Portal">
        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-white flex items-center justify-center p-1.5 shadow-sm transition-transform duration-200 group-hover:scale-105 flex-shrink-0">
          <img src="{{ asset('images/antigo-mark.png') }}" alt="Antigo Logo" class="w-full h-full object-contain">
        </div>
        <div class="flex flex-col justify-center leading-none">
          <span class="font-extrabold text-[16px] tracking-wide text-white uppercase font-poppins leading-none">ANTIGO</span>
          <span class="text-[9px] font-semibold tracking-widest text-[#DDEBFF] uppercase mt-1 font-poppins leading-none">UI/UX ADVISORY</span>
        </div>
      </a>

      <!-- Mobile Close Button -->
      <button type="button" 
              onclick="toggleClientSidebar()" 
              class="lg:hidden w-8 h-8 rounded-lg flex items-center justify-center text-white/70 hover:text-white hover:bg-white/10 transition-colors"
              aria-label="Close sidebar">
        <iconify-icon icon="lucide:x" class="text-xl"></iconify-icon>
      </button>
    </div>

    <!-- Navigation List -->
    <nav class="space-y-1.5 pt-2" data-turbo="false" data-turbo-prefetch="false" aria-label="Client Navigation">
      <!-- 1. Dashboard -->
      <a href="{{ path('client_dashboard') }}" 
         class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all group {{ currentRoute == 'client_dashboard' ? 'bg-white/15 text-white shadow-sm' : 'text-[#A5B3D8] hover:text-white hover:bg-white/5' }}">
        <div class="flex items-center gap-3">
          <iconify-icon icon="lucide:layout-dashboard" class="text-lg {{ currentRoute == 'client_dashboard' ? 'text-white' : 'text-[#8E9CC0] group-hover:text-white' }}"></iconify-icon>
          <span>Dashboard</span>
        </div>
      </a>

      <!-- 2. My Projects -->
      <a href="{{ path('client_projects') }}" 
         class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all group {{ currentRoute == 'client_projects' ? 'bg-white/15 text-white shadow-sm' : 'text-[#A5B3D8] hover:text-white hover:bg-white/5' }}">
        <div class="flex items-center gap-3">
          <iconify-icon icon="lucide:folder-kanban" class="text-lg {{ currentRoute == 'client_projects' ? 'text-white' : 'text-[#8E9CC0] group-hover:text-white' }}"></iconify-icon>
          <span>My Projects</span>
        </div>
      </a>

      <!-- 3. Messages -->
      <a href="{{ path('client_messages') }}" 
         class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all group {{ currentRoute == 'client_messages' ? 'bg-white/15 text-white shadow-sm' : 'text-[#A5B3D8] hover:text-white hover:bg-white/5' }}">
        <div class="flex items-center gap-3">
          <iconify-icon icon="lucide:message-square" class="text-lg {{ currentRoute == 'client_messages' ? 'text-white' : 'text-[#8E9CC0] group-hover:text-white' }}"></iconify-icon>
          <span>Messages</span>
        </div>
        {% if notifications.clientUnreadMessagesCount > 0 %}
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#6C5BB5] text-white shadow-sm">
            {{ notifications.clientUnreadMessagesCount }}
          </span>
        {% endif %}
      </a>

      <!-- 4. Files -->
      <a href="{{ path('client_files') }}" 
         class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all group {{ currentRoute == 'client_files' ? 'bg-white/15 text-white shadow-sm' : 'text-[#A5B3D8] hover:text-white hover:bg-white/5' }}">
        <div class="flex items-center gap-3">
          <iconify-icon icon="lucide:file-text" class="text-lg {{ currentRoute == 'client_files' ? 'text-white' : 'text-[#8E9CC0] group-hover:text-white' }}"></iconify-icon>
          <span>Files</span>
        </div>
      </a>

      <!-- 5. Settings -->
      <a href="{{ path('client_settings') }}" 
         class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all group {{ currentRoute == 'client_settings' ? 'bg-white/15 text-white shadow-sm' : 'text-[#A5B3D8] hover:text-white hover:bg-white/5' }}">
        <div class="flex items-center gap-3">
          <iconify-icon icon="lucide:settings" class="text-lg {{ currentRoute == 'client_settings' ? 'text-white' : 'text-[#8E9CC0] group-hover:text-white' }}"></iconify-icon>
          <span>Settings</span>
        </div>
      </a>
    </nav>
  </div>

  <!-- Bottom: Client User Snippet -->
  <div class="pt-4 border-t border-white/10 mt-auto">
    <div class="flex items-center justify-between px-2 py-2 rounded-xl hover:bg-white/5 transition-colors">
      <div class="flex items-center gap-3 min-w-0">
        <div class="relative flex-shrink-0">
          <div class="w-9 h-9 rounded-full bg-[#6C5BB5] text-white font-bold text-xs flex items-center justify-center border border-white/20 shadow-sm">
            MS
          </div>
          <span class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-emerald-500 ring-2 ring-[#13224B]"></span>
        </div>
        <div class="flex flex-col min-w-0">
          <span class="text-xs font-bold text-white truncate">Maria Santos</span>
          <span class="text-[10px] text-[#8E9CC0] font-medium truncate">Pesolink</span>
        </div>
      </div>

      <!-- Quick Switch to Admin or Sign Out -->
      <a href="{{ path('admin_overview') }}" 
         title="Switch to Admin Studio View" 
         class="w-8 h-8 rounded-lg flex items-center justify-center text-[#8E9CC0] hover:text-white hover:bg-white/10 transition-colors">
        <iconify-icon icon="lucide:arrow-right-left" class="text-sm"></iconify-icon>
      </a>
    </div>
  </div>
</aside>
