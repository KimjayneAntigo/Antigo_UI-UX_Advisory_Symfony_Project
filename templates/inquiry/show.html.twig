{% extends 'base.html.twig' %}

{% block title %}Inquiry{% endblock %}

{% block body %}
    <h1>Inquiry</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ inquiry.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ inquiry.name }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ inquiry.email }}</td>
            </tr>
            <tr>
                <th>Phone</th>
                <td>{{ inquiry.phone }}</td>
            </tr>
            <tr>
                <th>Company</th>
                <td>{{ inquiry.company }}</td>
            </tr>
            <tr>
                <th>Service</th>
                <td>{{ inquiry.service }}</td>
            </tr>
            <tr>
                <th>Budget</th>
                <td>{{ inquiry.budget }}</td>
            </tr>
            <tr>
                <th>Timeline</th>
                <td>{{ inquiry.timeline }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ inquiry.description }}</td>
            </tr>
            <tr>
                <th>Attached_file</th>
                <td>{{ inquiry.attachedFile }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ inquiry.status }}</td>
            </tr>
            <tr>
                <th>Created_at</th>
                <td>{{ inquiry.createdAt ? inquiry.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_inquiry_index') }}">back to list</a>

    <a href="{{ path('app_inquiry_edit', {'id': inquiry.id}) }}">edit</a>

    {{ include('inquiry/_delete_form.html.twig') }}
{% endblock %}
